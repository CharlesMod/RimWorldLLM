<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>disable</Nullable>
        <LangVersion>latest</LangVersion>
        <IsPackable>false</IsPackable>
        <RootNamespace>RimWorldLLM.Tests</RootNamespace>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
        <PackageReference Include="xunit" Version="2.9.2" />
        <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    </ItemGroup>
    <ItemGroup>
        <!-- The game-agnostic bridge and the pure rules compile straight into the tests; nothing here references the game. -->
        <Compile Remove="PreviewEmit/**" />
        <Compile Include="../Mod/Source/Bridge/**/*.cs" />
        <Compile Include="../Mod/Source/Mind/**/*.cs" />
        <Compile Include="../Mod/Source/RimWorld/Rules.cs" />
        <Compile Include="../Mod/Source/RimWorld/Effects.cs" />
        <Compile Include="../Mod/Source/RimWorld/BubbleLayout.cs" />
        <Compile Include="../Mod/Source/RimWorld/ThoughtPacing.cs" />
        <Compile Include="../Mod/Source/RimWorld/VivariumHandsPure.cs" />
        <Compile Include="../Mod/Source/RimWorld/VivariumChatParse.cs" />
    <Compile Include="../Mod/Source/RimWorld/VivariumChatLayout.cs" />
        <Compile Include="../Mod/Source/RimWorld/VivariumFactsPure.cs" />
    </ItemGroup>

    <!-- csmind-side: the steward's data files (byte-identical copies of the Python package's strategy/rules.json,
         strategy/steward_strategy.md and steward_system.txt), embedded with fixed logical names that
         RimWorldLLM.Mind.RimWorld.StewardResources reads. -->
    <ItemGroup>
        <EmbeddedResource Include="../Mod/Source/Mind/RimWorld/Resources/rules.json" LogicalName="RimWorldLLM.Mind.rules.json" />
        <EmbeddedResource Include="../Mod/Source/Mind/RimWorld/Resources/steward_strategy.md" LogicalName="RimWorldLLM.Mind.steward_strategy.md" />
        <EmbeddedResource Include="../Mod/Source/Mind/RimWorld/Resources/steward_system.txt" LogicalName="RimWorldLLM.Mind.steward_system.txt" />
    </ItemGroup>

    <!-- csmind-side: test data generated or copied from the Python tests (see docs/csmind/parity-side.md). -->
    <ItemGroup>
        <EmbeddedResource Include="Mind/Data/steward_golden.json" LogicalName="RimWorldLLM.Tests.steward_golden.json" />
        <EmbeddedResource Include="Mind/Data/steward_digest_sample.json" LogicalName="RimWorldLLM.Tests.steward_digest_sample.json" />
        <EmbeddedResource Include="Mind/Data/core_golden.json" LogicalName="RimWorldLLM.Tests.core_golden.json" />
        <EmbeddedResource Include="Mind/Data/jobs-art-golden.json" LogicalName="RimWorldLLM.Tests.jobs-art-golden.json" />
        <EmbeddedResource Include="Mind/Data/jobs-lore-golden.json" LogicalName="RimWorldLLM.Tests.jobs-lore-golden.json" />
        <EmbeddedResource Include="Mind/Data/jobs-recap-golden.json" LogicalName="RimWorldLLM.Tests.jobs-recap-golden.json" />
        <EmbeddedResource Include="Mind/Data/jobs-dreams-golden.json" LogicalName="RimWorldLLM.Tests.jobs-dreams-golden.json" />
    </ItemGroup>

</Project>
