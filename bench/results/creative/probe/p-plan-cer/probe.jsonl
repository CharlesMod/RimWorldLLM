{"arm": "plan", "sets": {"creative_ground": true, "aim_ground": true, "creative_plan": true}, "feature": "vows", "case": "vow_cy", "rep": 0, "actor": 3, "text": "Mara, I promise to always ensure there is a worthy meal waiting for you.", "drop": null, "latency_s": 1.8089, "calls": 2, "slot_s": 1.8031, "context": {"occasion": "wedding", "deceased": "", "couple": ["Cy", "Mara"], "speaker": "Cy"}}
{"arm": "plan", "sets": {"creative_ground": true, "aim_ground": true, "creative_plan": true}, "feature": "vows", "case": "vow_mara", "rep": 0, "actor": 9, "text": "I promise to share my life with you, friend.", "drop": null, "latency_s": 1.6806, "calls": 2, "slot_s": 1.6726, "context": {"occasion": "wedding", "deceased": "", "couple": ["Cy", "Mara"], "speaker": "Mara"}}
{"arm": "plan", "sets": {"creative_ground": true, "aim_ground": true, "creative_plan": true}, "feature": "eulogy", "case": "eulogy_odo", "rep": 1, "actor": 1, "text": "Old Odo always cared if the rows were straight, even at the very end. Now we have to get back to the fire and get dinner cooked, friend.", "drop": null, "latency_s": 2.2639, "calls": 2, "slot_s": 2.2543, "context": {"occasion": "funeral", "deceased": "Old Odo", "couple": [], "speaker": "Ana"}}
{"arm": "plan", "sets": {"creative_ground": true, "aim_ground": true, "creative_plan": true}, "feature": "eulogy", "case": "eulogy_hale", "rep": 1, "actor": 4, "text": "He was a fighter. Enough. He fought hard enough.", "drop": null, "latency_s": 1.7631, "calls": 2, "slot_s": 1.7549, "context": {"occasion": "funeral", "deceased": "Hale", "couple": [], "speaker": "Dee"}}
{"arm": "plan", "sets": {"creative_ground": true, "aim_ground": true, "creative_plan": true}, "feature": "vows", "case": "vow_cy", "rep": 1, "actor": 3, "text": "I promise to share every meal and every sunrise with you.", "drop": null, "latency_s": 1.6664, "calls": 2, "slot_s": 1.6576, "context": {"occasion": "wedding", "deceased": "", "couple": ["Cy", "Mara"], "speaker": "Cy"}}
{"arm": "plan", "sets": {"creative_ground": true, "aim_ground": true, "creative_plan": true}, "feature": "vows", "case": "vow_mara", "rep": 1, "actor": 9, "text": "I promise you my quiet light, Cy, through all weather.", "drop": null, "latency_s": 1.7454, "calls": 2, "slot_s": 1.7367, "context": {"occasion": "wedding", "deceased": "", "couple": ["Cy", "Mara"], "speaker": "Mara"}}
{"arm": "plan", "sets": {"creative_ground": true, "aim_ground": true, "creative_plan": true}, "feature": "eulogy", "case": "eulogy_odo", "rep": 2, "actor": 1, "text": "Odo always kept to himself, but his quiet life among the rice rows was honest. Now we have to move on with the next meal, friend.", "drop": null, "latency_s": 1.9872, "calls": 2, "slot_s": 1.9785, "context": {"occasion": "funeral", "deceased": "Old Odo", "couple": [], "speaker": "Ana"}}
{"arm": "plan", "sets": {"creative_ground": true, "aim_ground": true, "creative_plan": true}, "feature": "eulogy", "case": "eulogy_hale", "rep": 2, "actor": 4, "text": "He felled a beast and then he was taken by men. Enough. He was tough, always.", "drop": null, "latency_s": 1.8668, "calls": 2, "slot_s": 1.8583, "context": {"occasion": "funeral", "deceased": "Hale", "couple": [], "speaker": "Dee"}}
{"arm": "plan", "sets": {"creative_ground": true, "aim_ground": true, "creative_plan": true}, "feature": "vows", "case": "vow_cy", "rep": 2, "actor": 3, "text": "With you, Mara, there is a good meal waiting for me always.", "drop": null, "latency_s": 1.717, "calls": 2, "slot_s": 1.7078, "context": {"occasion": "wedding", "deceased": "", "couple": ["Cy", "Mara"], "speaker": "Cy"}}
{"arm": "plan", "sets": {"creative_ground": true, "aim_ground": true, "creative_plan": true}, "feature": "vows", "case": "vow_mara", "rep": 2, "actor": 9, "text": "I will stand by you always, friend, through all the harsh years.", "drop": null, "latency_s": 1.8366, "calls": 2, "slot_s": 1.8277, "context": {"occasion": "wedding", "deceased": "", "couple": ["Cy", "Mara"], "speaker": "Mara"}}
{"arm": "plan", "sets": {"creative_ground": true, "aim_ground": true, "creative_plan": true}, "feature": "eulogy", "case": "eulogy_odo", "rep": 3, "actor": 1, "text": "Old Odo, a man who asked about the rows, rests now with the whole group.", "drop": null, "latency_s": 2.0628, "calls": 2, "slot_s": 2.0543, "context": {"occasion": "funeral", "deceased": "Old Odo", "couple": [], "speaker": "Ana"}}
{"arm": "plan", "sets": {"creative_ground": true, "aim_ground": true, "creative_plan": true}, "feature": "eulogy", "case": "eulogy_hale", "rep": 3, "actor": 4, "text": "He killed the thrumbo, good work. I couldn't reach him in time, not in time.", "drop": null, "latency_s": 2.0514, "calls": 2, "slot_s": 2.0426, "context": {"occasion": "funeral", "deceased": "Hale", "couple": [], "speaker": "Dee"}}
{"arm": "plan", "sets": {"creative_ground": true, "aim_ground": true, "creative_plan": true}, "feature": "vows", "case": "vow_cy", "rep": 3, "actor": 3, "text": "Mara you are my only worthy sustenance.", "drop": null, "latency_s": 1.7507, "calls": 2, "slot_s": 1.742, "context": {"occasion": "wedding", "deceased": "", "couple": ["Cy", "Mara"], "speaker": "Cy"}}
{"arm": "plan", "sets": {"creative_ground": true, "aim_ground": true, "creative_plan": true}, "feature": "vows", "case": "vow_mara", "rep": 3, "actor": 9, "text": "I promise to always keep you safe, friend.", "drop": null, "latency_s": 1.8718, "calls": 2, "slot_s": 1.863, "context": {"occasion": "wedding", "deceased": "", "couple": ["Cy", "Mara"], "speaker": "Mara"}}
