<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!-- Effects of spoken lines (SPEC section 8). Mood: 1-3 points for under a day. Opinion: 5 points fading over about 10 days.
       Stack limit 3 per pair. The mod scales the size by the effects setting and sets the description to the line that caused it. -->

  <!-- ================= mood thoughts ================= -->
  <ThoughtDef>
    <defName>RWL_Kind_Mood</defName>
    <thoughtClass>RimWorldLLM.Thought_RWLMemory</thoughtClass>
    <durationDays>0.75</durationDays>
    <stackLimit>3</stackLimit>
    <stackedEffectMultiplier>1</stackedEffectMultiplier>
    <stages>
      <li>
        <label>kind words</label>
        <description>Someone said something kind to me.</description>
        <baseMoodEffect>1</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>RWL_Comforted_Mood</defName>
    <thoughtClass>RimWorldLLM.Thought_RWLMemory</thoughtClass>
    <durationDays>0.75</durationDays>
    <stackLimit>3</stackLimit>
    <stackedEffectMultiplier>1</stackedEffectMultiplier>
    <stages>
      <li>
        <label>comforted</label>
        <description>Someone comforted me when I was down.</description>
        <baseMoodEffect>3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>RWL_Insulted_Mood</defName>
    <thoughtClass>RimWorldLLM.Thought_RWLMemory</thoughtClass>
    <durationDays>0.75</durationDays>
    <stackLimit>3</stackLimit>
    <stackedEffectMultiplier>1</stackedEffectMultiplier>
    <stages>
      <li>
        <label>insulted</label>
        <description>Someone insulted me.</description>
        <baseMoodEffect>-2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- ================= opinion thoughts ================= -->
  <ThoughtDef Name="RWL_OpinionBase" Abstract="True">
    <thoughtClass>RimWorldLLM.Thought_RWLSocial</thoughtClass>
    <durationDays>10</durationDays>
    <stackLimit>3</stackLimit>
    <stackLimitForSameOtherPawn>3</stackLimitForSameOtherPawn>
    <stackedEffectMultiplier>1</stackedEffectMultiplier>
  </ThoughtDef>
  <ThoughtDef ParentName="RWL_OpinionBase">
    <defName>RWL_Kind_Opinion</defName>
    <stages><li><label>kind words</label><baseOpinionOffset>5</baseOpinionOffset></li></stages>
  </ThoughtDef>
  <ThoughtDef ParentName="RWL_OpinionBase">
    <defName>RWL_Comforted_Opinion</defName>
    <stages><li><label>comforted me</label><baseOpinionOffset>5</baseOpinionOffset></li></stages>
  </ThoughtDef>
  <ThoughtDef ParentName="RWL_OpinionBase">
    <defName>RWL_Slight_Opinion</defName>
    <stages><li><label>slighted me</label><baseOpinionOffset>-5</baseOpinionOffset></li></stages>
  </ThoughtDef>
  <ThoughtDef ParentName="RWL_OpinionBase">
    <defName>RWL_Insulted_Opinion</defName>
    <stages><li><label>insulted me</label><baseOpinionOffset>-5</baseOpinionOffset></li></stages>
  </ThoughtDef>
  <ThoughtDef ParentName="RWL_OpinionBase">
    <defName>RWL_InsultWitnessed_Opinion</defName>
    <stages><li><label>insulted someone</label><baseOpinionOffset>-2</baseOpinionOffset></li></stages>
  </ThoughtDef>
  <ThoughtDef ParentName="RWL_OpinionBase">
    <defName>RWL_Confided_Opinion</defName>
    <stages><li><label>confided in me</label><baseOpinionOffset>5</baseOpinionOffset></li></stages>
  </ThoughtDef>
  <ThoughtDef ParentName="RWL_OpinionBase">
    <defName>RWL_Confiding_Opinion</defName>
    <stages><li><label>I confided in them</label><baseOpinionOffset>3</baseOpinionOffset></li></stages>
  </ThoughtDef>
  <ThoughtDef ParentName="RWL_OpinionBase">
    <defName>RWL_Gossip_Opinion</defName>
    <stages><li><label>gossip about them</label><baseOpinionOffset>-3</baseOpinionOffset></li></stages>
  </ThoughtDef>
  <ThoughtDef ParentName="RWL_OpinionBase">
    <defName>RWL_Boast_Opinion</defName>
    <stages><li><label>boasted to me</label><baseOpinionOffset>-2</baseOpinionOffset></li></stages>
  </ThoughtDef>
  <ThoughtDef ParentName="RWL_OpinionBase">
    <defName>RWL_Complain_Opinion</defName>
    <stages><li><label>complained to me</label><baseOpinionOffset>-2</baseOpinionOffset></li></stages>
  </ThoughtDef>
</Defs>
