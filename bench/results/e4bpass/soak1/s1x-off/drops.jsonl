d": 0, "lines": 17, "rotations": 8, "ends": {"turn_cap": 4, "dropped": 1}}, "loop": {"checked": 36, "caught": 0, "retried": 0, "recovered": 0, "ended": 0, "trace": [{"conv": "c-1", "speaker": 1, "turn": 0, "attempt": 0, "text": "Bram, you're doing a fine spread today; everything smells good friend.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "c-1", "speaker": 2, "turn": 1, "attempt": 0, "text": "Look. The stew costs three silver per portion, Ana.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "c-1", "speaker": 1, "turn": 2, "attempt": 0, "text": "The stew looks good, friend. We'll see how everyone settles with it.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "c-1", "speaker": 2, "turn": 3, "attempt": 0, "text": "Look. The broth alone cost two copper today.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "c-2", "speaker": 2, "turn": 0, "attempt": 0, "text": "Look. Your roux is costing us flavor for a mere copper.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "c-2", "speaker": 3, "turn": 1, "attempt": 0, "text": "Um... I thought the roux needed... more patience, Bram.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "c-3", "speaker": 5, "turn": 0, "attempt": 0, "text": "Bram, are you feeling steady with all this cooking going on?", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "g-4", "speaker": 3, "turn": 0, "attempt": 0, "text": "Odo was a steady hand in the kitchen, always ready for the next meal... I hope there's something decent for supper later.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "g-4", "speaker": 1, "turn": 1, "attempt": 0, "text": "Odo knew how to keep the pantry full, that one.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "g-4", "speaker": 5, "turn": 2, "attempt": 0, "text": "He made sure everyone had something to eat, friend.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "g-5", "speaker": 1, "turn": 0, "attempt": 0, "text": "I've noticed a few chats between the friends while the heat was on the stove.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "g-5", "speaker": 2, "turn": 1, "attempt": 0, "text": "Look. At least they were worth the wasted heat.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "g-5", "speaker": 10, "turn": 2, "attempt": 0, "text": "Look. Wasted heat isn't the only thing getting wasted here.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "g-5", "speaker": 3, "turn": 3, "attempt": 0, "text": "Well, the meat needs more salt before the next meal, doesn't it?", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "g-5", "speaker": 1, "turn": 4, "attempt": 0, "text": "Cy, you worry too much about the salt; the flavors are already working well enough.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "g-6", "speaker": 5, "turn": 0, "attempt": 0, "text": "The food is ready, friend; we'll see what good company this party brings.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "g-6", "speaker": 6, "turn": 1, "attempt": 0, "text": "There's a good spread today, friend. We ought to sit down.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "g-6", "speaker": 10, "turn": 2, "attempt": 0, "text": "Look. Sit down if you must, but don't expect the food to fix everything.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "g-6", "speaker": 9, "turn": 3, "attempt": 0, "text": "The sky is bright but the mess needs clearing out.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "g-6", "speaker": 5, "turn": 4, "attempt": 0, "text": "Tam, I can see that. We'll organize the mess later.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "g-7", "speaker": 4, "turn": 0, "attempt": 0, "text": "This gathering, it is about Odo. Odo died.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "g-7", "speaker": 3, "turn": 1, "attempt": 0, "text": "Dee is talking about Odo, but I hope there is good food coming.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "g-7", "speaker": 1, "turn": 2, "attempt": 0, "text": "The table will be set soon, friend; we need to make sure everyone has a full plate.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "c-8", "speaker": 1, "turn": 0, "attempt": 0, "text": "How is your cooking coming, friend? We'll see what the morning brings for this meal.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "c-8", "speaker": 2, "turn": 1, "attempt": 0, "text": "Look. This meal costs time, and time has a steep price.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "c-8", "speaker": 1, "turn": 2, "attempt": 0, "text": "The stew needs just a bit more patience to soften the tough bits, friend.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "c-9", "speaker": 10, "turn": 0, "attempt": 0, "text": "Look. Did you have to mention the chores again?", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "c-9", "speaker": 2, "turn": 1, "attempt": 0, "text": "Look. The cost of an empty floor is higher than the chore itself, little one.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "c-9", "speaker": 10, "turn": 2, "attempt": 0, "text": "Bram is stalling. Just tell me where the food is.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "c-10", "speaker": 2, "turn": 0, "attempt": 0, "text": "Look. Is that all your protest cost, or do you expect repayment?", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv"