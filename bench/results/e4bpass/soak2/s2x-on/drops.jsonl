}, "art": {"dropped": 0, "unsupported": false}, "bystand": {"asked": 3, "shown": 1, "templated": 1, "dropped": 0, "skipped": 0}, "group": {"skipped": 0, "lines": 11, "rotations": 5, "ends": {"over": 2, "turn_cap": 2}}, "loop": {"checked": 15, "caught": 0, "retried": 0, "recovered": 0, "ended": 0, "trace": [{"conv": "c-1", "speaker": 1, "turn": 0, "attempt": 0, "text": "You're getting enough fuel for everyone today, friend?", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "c-1", "speaker": 2, "turn": 1, "attempt": 0, "text": "Look. The stew cost four days of meat; eat it or starve.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "c-1", "speaker": 1, "turn": 2, "attempt": 0, "text": "That stew smells decent, Bram, but we'll see if it fills everyone up properly.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "c-1", "speaker": 2, "turn": 3, "attempt": 0, "text": "Look. Dee's portion looks a little smaller than the others.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "g-3", "speaker": 1, "turn": 0, "attempt": 0, "text": "Bram always was better at tending the fire than at talking to me, friend.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "g-3", "speaker": 2, "turn": 1, "attempt": 0, "text": "Look. At least I manage the hearth, something worth more than soft words.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "g-3", "speaker": 10, "turn": 2, "attempt": 0, "text": "Look. At least he doesn't burn the stew on purpose.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "g-3", "speaker": 3, "turn": 3, "attempt": 0, "text": "Well, at least the stew isn't completely inedible, that is...", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "g-4", "speaker": 9, "turn": 0, "attempt": 0, "text": "Uma talked to Bram about chores, and I asked Ana about the stars.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "g-4", "speaker": 5, "turn": 1, "attempt": 0, "text": "The stars are just patterns of fire that shine on the cold.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "g-4", "speaker": 6, "turn": 2, "attempt": 0, "text": "Patterns of fire, yeah. Sounds like a fine sight to look at.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "g-4", "speaker": 10, "turn": 3, "attempt": 0, "text": "Look. Fire is just hot gas, patterns are just lines.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "g-5", "speaker": 1, "turn": 0, "attempt": 0, "text": "I will always keep this hearth warm for you, friend.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "g-5", "speaker": 2, "turn": 1, "attempt": 0, "text": "Look, I will keep this order true for all the harvest.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "g-5", "speaker": 3, "turn": 2, "attempt": 0, "text": "Um... that sounds like a proper structure for a life.", "refused": false, "against": null, "score": 0.0, "kind": null}]}, "grudges": {"started": 2, "made_up": 0, "escalated": 0, "faded": 0, "seeks": 0}, "chronicle_last_drop": "", "lease_log_counts": {"drop:gap": 3, "expired:bystander:10": 1, "expired:bystander:4": 1, "expired:first_cue:2": 1, "expired:first_cue:3": 1, "expired:first_cue:5": 1, "expired:first_cue:9": 1, "expired:gathering:3": 1, "expired:injury:3": 1, "expired:injury:4": 1, "expired:injury:5": 1, "expired:injury:6": 1, "expired:injury:7": 1, "expired:injury:8": 1, "expired:level_up:5": 1, "expired:social:1": 1, "expired:social:10": 1, "expired:social:2": 2, "expired:social:4": 1, "expired:social:5": 3, "expired:social:6": 2, "expired:social:7": 2, "expired:social:8": 2, "expired:social:9": 1, "expired:tend:4": 1, "lease:slot1:actor10:IDLE": 10, "lease:slot1:actor11:IDLE": 5, "lease:slot1:actor1:AMBIENT": 1, "lease:s