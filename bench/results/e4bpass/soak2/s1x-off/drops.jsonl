 "ended": 0, "trace": [{"conv": "c-1", "speaker": 1, "turn": 0, "attempt": 0, "text": "You alright, friend, how's the broth shaping up this morning?", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "c-1", "speaker": 2, "turn": 1, "attempt": 0, "text": "Look. It costs half a decent meal to make broth this good.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "c-2", "speaker": 10, "turn": 0, "attempt": 0, "text": "Look. Did you actually think I'd forgotten what we agreed upon about chores?", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "c-2", "speaker": 2, "turn": 1, "attempt": 0, "text": "Look. The agreed cost of your forgetfulness is a reprimand, Uma.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "c-3", "speaker": 9, "turn": 0, "attempt": 0, "text": "The stars looked like spilled flour up there.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "c-3", "speaker": 1, "turn": 1, "attempt": 0, "text": "They are just seeds waiting for the right soil, friend.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "c-4", "speaker": 2, "turn": 0, "attempt": 0, "text": "Look. Your chopping speed is slow; even a grunt could manage more in the time you spend with that dull blade.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "c-5", "speaker": 2, "turn": 0, "attempt": 0, "text": "Look. Your ladle movements cost you precision, Dee.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "c-5", "speaker": 4, "turn": 1, "attempt": 0, "text": "Enough. My movements are sufficient, they are.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "c-5", "speaker": 2, "turn": 2, "attempt": 0, "text": "Look. Precision costs more than simply moving that heavy spoon.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "g-6", "speaker": 3, "turn": 0, "attempt": 0, "text": "Um... Odo. He always had a steady hand with a knife. We should get back to the meal preparations now.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "g-6", "speaker": 1, "turn": 1, "attempt": 0, "text": "He always did know how to make a good stew, even when things were rough.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "g-6", "speaker": 5, "turn": 2, "attempt": 0, "text": "His stew always warmed us through the coldest nights.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "g-7", "speaker": 1, "turn": 0, "attempt": 0, "text": "The quiet after that day still feels heavy, friend.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "g-7", "speaker": 2, "turn": 1, "attempt": 0, "text": "Look. Quiet always costs someone something.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "g-7", "speaker": 10, "turn": 2, "attempt": 0, "text": "Look. You just talk about costs. What about the good rations we have left?", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "g-7", "speaker": 3, "turn": 3, "attempt": 0, "text": "Um, I think the next task is clearing these pots before we move on to... well, whatever.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "g-7", "speaker": 1, "turn": 4, "attempt": 0, "text": "We'll see about clearing pots when the stew is done, friend.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "g-8", "speaker": 5, "turn": 0, "attempt": 0, "text": "The cooking smells decent today, everyone working hard.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "g-8", "speaker": 6, "turn": 1, "attempt": 0, "text": "The stew smells good friend.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "g-8", "speaker": 10, "turn": 2, "attempt": 0, "text": "Look. Smells like desperation and boiled things.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "g-8", "speaker": 9, "turn": 3, "attempt": 0, "text": "We'll see, Uma. The pot always spits.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "g-8", "speaker": 5, "turn": 4, "attempt": 0, "text": "Uma needs to stop souring the mood, friend.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "g-9", "speaker": 4, "turn": 0, "attempt": 0, "text": "Enough. We eat now. We eat now.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "g-9", "speaker": 3, "turn": 1, "attempt": 0, "text": "Um... so we eat. Is there enough stew?", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "g-9", "speaker": 1, "turn": 2, "attempt": 0, "text": "The stew is thick, friend, let's see if we've cooked it well enough.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "c-10", "speaker": 1, "turn": 0, "attempt": 0, "text": "How are you doing today, friend? The simmering pot looks good.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "c-10", "speaker": 2, "turn": 1, "attempt": 0, "text": "Look. The broth cost a handful of salt, Ana, and that is all.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "c-10", "speaker": 1, "turn": 2, "attempt": 0, "text": "It is a good broth, friend, it takes what we have and makes it something good.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "c-11", "speaker": 10, "turn": 0, "attempt": 0, "text": "Look. The stew is still not adequately seasoned, Bram.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "c-11", "speaker": 2, "turn": 1, "attempt": 0, "text": "Look. If you add more salt it costs us nothing, little Uma.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "c-11", "speaker": 10, "turn": 2, "attempt": 0, "text": "Look. You simply lack the taste for balance.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "c-11", "speaker": 2, "turn": 3, "attempt": 0, "text": "Look. You should count the spoons before you count the seasoning, Uma.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "c-12", "speaker": 2, "turn": 0, "attempt": 0, "text": "Look. That ladle wobble is costing us efficiency, Dee.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "c-12", "speaker": 4, "turn": 1, "attempt": 0, "text": "Enough. You criticize my work, you criticize my work.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "c-13", "speaker": 1, "turn": 0, "attempt": 0, "text": "The soup is coming along nicely, friend, how's this morning treating you?", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "c-13", "speaker": 3, "turn": 1, "attempt": 0, "text": "Um, is the soup going to be ready for the next meal soon.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "c-13", "speaker": 1, "turn": 2, "attempt": 0, "text": "It'll be ready when it's ready, friend; this broth is holding steady.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "c-13", "speaker": 3, "turn": 3, "attempt": 0, "text": "Is it... is there something more to it than just broth and hunger?", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "c-13", "speaker": 1, "turn": 4, "attempt": 0, "text": "It's a comfort, Cy; warmth in a cold house.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "g-14", "speaker": 1, "turn": 0, "attempt": 0, "text": "Bram, you always cook best when we're all gathered around the pot, friend.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "g-14", "speaker": 2, "turn": 1, "attempt": 0, "text": "Look. The pot is full enough; one can't stretch the last scraps.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "g-14", "speaker": 10, "turn": 2, "attempt": 0, "text": "Look. At least there's some meat left for us.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "g-14", "speaker": 3, "turn": 3, "attempt": 0, "text": "If there's more cooking to do after this, I hope it's something substantial.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "g-14", "speaker": 1, "turn": 4, "attempt": 0, "text": "We'll see if we can find more ingredients later, friend.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "g-15", "speaker": 1, "turn": 0, "attempt": 0, "text": "You'll always have a warm plate at the end of the day, my friend.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "g-15", "speaker": 2, "turn": 1, "attempt": 0, "text": "Look. My share of this life I will keep for you.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "g-15", "speaker": 3, "turn": 2, "attempt": 0, "text": "Well, this is quite the celebration, hope the meal is good.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "g-16", "speaker": 4, "turn": 0, "attempt": 0, "text": "Enough. This is the Long Table, the Long Table.", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "g-16", "speaker": 3, "turn": 1, "attempt": 0, "text": "Is this... the Long Table, Dee?", "refused": false, "against": null, "score": 0.0, "kind": null}, {"conv": "g-16", "speaker": 1, "turn": 2, "attempt": 0, "text": "That's a hearty serving of sentiment, Dee.", "refused": false, "against": null, "score": 0.0, "kind": null}]}, "grudges": {"started": 3, "made_up": 0, "escalated": 0, "faded": 2, "seeks": 7}, "chronicle_last_drop": "", "lease_log_counts": {"drop:actor_quota": 1, "drop:ambient_quota": 2, "drop:gap": 8, "expired:bystander:10": 1, "expired:bystander:3": 1, "expired:bystander:4": 1, "expired:bystander:7": 1